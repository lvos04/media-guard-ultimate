+using System;
+using System.Collections.Generic;
+using FluentAssertions;
+using Moq;
+using NUnit.Framework;
+using NzbDrone.Core.Download;
+using NzbDrone.Core.MediaFiles.MediaInfo;
+using NzbDrone.Core.MediaFiles.MovieImport;
+using NzbDrone.Core.MediaFiles.MovieImport.Specifications;
+using NzbDrone.Core.MediaGuard;
+using NzbDrone.Core.Movies;
+using NzbDrone.Core.Parser.Model;
+using NzbDrone.Core.Test.Framework;
+
+namespace NzbDrone.Core.Test.MediaFiles.MovieImport.Specifications
+{
+    [TestFixture]
+    public class MediaGuardPreImportSpecificationFixture : CoreTest<MediaGuardPreImportSpecification>
+    {
+        private MediaGuardHookOptions _options;
+        private LocalMovie _localMovie;
+        private DownloadClientItem _downloadClientItem;
+        private object _payload;
+
+        [SetUp]
+        public void Setup()
+        {
+            _options = new MediaGuardHookOptions { Url = "http://core:8100", InstanceId = "radarr-films", HookKey = "k" };
+
+            _localMovie = new LocalMovie
+            {
+                Path = "/downloads/complete/movies/Movie.2001.1080p.mkv",
+                Size = 123,
+                Movie = new Movie { Id = 1, MovieFileId = 9, MovieMetadata = new MovieMetadata { TmdbId = 2, Title = "Movie", Year = 2001 } },
+                FileMovieInfo = new ParsedMovieInfo { Year = 2001, MovieTitles = new List<string> { "Movie" } },
+                MediaInfo = new MediaInfoModel { VideoFormat = "hevc", AudioLanguages = new List<string> { "jpn", "eng" }, Subtitles = new List<string>(), Width = 3840, Height = 2160, RunTime = TimeSpan.FromSeconds(7200) }
+            };
+
+            _downloadClientItem = new DownloadClientItem
+            {
+                DownloadId = "SABnzbd_nzo_2",
+                Title = "Movie.2001.1080p.BluRay",
+                DownloadClientInfo = new DownloadClientItemClientInfo { Name = "SABnzbd" }
+            };
+
+            Mocker.GetMock<IMediaGuardHookClient>().SetupGet(v => v.Options).Returns(() => _options);
+        }
+
+        private void GivenDecision(MediaGuardDecision decision, bool unavailable = false)
+        {
+            Mocker.GetMock<IMediaGuardHookClient>()
+                  .Setup(v => v.Send(MediaGuardPreImportSpecification.Hook, It.IsAny<object>()))
+                  .Callback<string, object>((h, p) => _payload = p)
+                  .Returns(new MediaGuardHookResult { Decision = decision, ReasonCode = "IDENTITY_MISMATCH", Message = "Twijfel", Unavailable = unavailable });
+        }
+
+        [Test]
+        public void should_accept_without_call_when_disabled()
+        {
+            _options.Url = "";
+
+            Subject.IsSatisfiedBy(_localMovie, _downloadClientItem).Accepted.Should().BeTrue();
+            Mocker.GetMock<IMediaGuardHookClient>().Verify(v => v.Send(It.IsAny<string>(), It.IsAny<object>()), Times.Never());
+        }
+
+        [Test]
+        public void should_skip_existing_files()
+        {
+            _localMovie.ExistingFile = true;
+
+            Subject.IsSatisfiedBy(_localMovie, _downloadClientItem).Accepted.Should().BeTrue();
+            Mocker.GetMock<IMediaGuardHookClient>().Verify(v => v.Send(It.IsAny<string>(), It.IsAny<object>()), Times.Never());
+        }
+
+        [Test]
+        public void should_accept()
+        {
+            GivenDecision(MediaGuardDecision.Accept);
+
+            Subject.IsSatisfiedBy(_localMovie, _downloadClientItem).Accepted.Should().BeTrue();
+
+            var payload = (MediaGuardPreImportRequest)_payload;
+            payload.App.Should().Be("radarr");
+            payload.DownloadId.Should().Be("SABnzbd_nzo_2");
+            payload.IsUpgrade.Should().BeTrue();
+            payload.Movie.TmdbId.Should().Be(2);
+            payload.MediaInfo.Resolution.Should().Be("3840x2160");
+            payload.MediaInfo.AudioLanguages.Should().Equal("jpn", "eng");
+            payload.Parsed.Year.Should().Be(2001);
+        }
+
+        [TestCase(MediaGuardDecision.Reject, false, ImportRejectionReason.MediaGuardRejected)]
+        [TestCase(MediaGuardDecision.Defer, false, ImportRejectionReason.MediaGuardDeferred)]
+        [TestCase(MediaGuardDecision.Reject, true, ImportRejectionReason.MediaGuardUnavailable)]
+        public void should_reject(MediaGuardDecision decision, bool unavailable, ImportRejectionReason reason)
+        {
+            GivenDecision(decision, unavailable);
+
+            var result = Subject.IsSatisfiedBy(_localMovie, _downloadClientItem);
+
+            result.Accepted.Should().BeFalse();
+            result.Reason.Should().Be(reason);
+            result.Message.Should().Be("MediaGuard: Twijfel [IDENTITY_MISMATCH]");
+        }
+    }
+}
