+using FluentAssertions;
+using Moq;
+using NUnit.Framework;
+using NzbDrone.Core.DecisionEngine;
+using NzbDrone.Core.DecisionEngine.Specifications;
+using NzbDrone.Core.IndexerSearch.Definitions;
+using NzbDrone.Core.MediaGuard;
+using NzbDrone.Core.Movies;
+using NzbDrone.Core.Parser.Model;
+using NzbDrone.Core.Qualities;
+using NzbDrone.Core.Test.Framework;
+
+namespace NzbDrone.Core.Test.DecisionEngineTests
+{
+    [TestFixture]
+    public class MediaGuardPreGrabSpecificationFixture : CoreTest<MediaGuardPreGrabSpecification>
+    {
+        private MediaGuardHookOptions _options;
+        private RemoteMovie _remoteMovie;
+        private object _payload;
+
+        [SetUp]
+        public void Setup()
+        {
+            _options = new MediaGuardHookOptions { Url = "http://core:8100", InstanceId = "radarr-animefilms", HookKey = "k" };
+
+            _remoteMovie = new RemoteMovie
+            {
+                Release = new ReleaseInfo { Title = "Spirited.Away.2001.1080p.BluRay.x264-Group", Guid = "g1", IndexerId = 3, Indexer = "Fake" },
+                ParsedMovieInfo = new ParsedMovieInfo { Year = 2001, Quality = new QualityModel(Quality.Bluray1080p), ReleaseGroup = "Group" },
+                Movie = new Movie { Id = 12, MovieMetadata = new MovieMetadata { TmdbId = 129, ImdbId = "tt0245429", Title = "Spirited Away", Year = 2001 } },
+                CustomFormatScore = 100
+            };
+
+            Mocker.GetMock<IMediaGuardHookClient>().SetupGet(v => v.Options).Returns(() => _options);
+        }
+
+        private void GivenResult(MediaGuardHookResult result)
+        {
+            Mocker.GetMock<IMediaGuardHookClient>()
+                  .Setup(v => v.Send(MediaGuardPreGrabSpecification.Hook, It.IsAny<object>()))
+                  .Callback<string, object>((h, p) => _payload = p)
+                  .Returns(result);
+        }
+
+        [Test]
+        public void should_accept_without_call_when_hooks_disabled()
+        {
+            _options.Url = null;
+
+            Subject.IsSatisfiedBy(_remoteMovie, new ReleaseDecisionInformation()).Accepted.Should().BeTrue();
+            Mocker.GetMock<IMediaGuardHookClient>().Verify(v => v.Send(It.IsAny<string>(), It.IsAny<object>()), Times.Never());
+        }
+
+        [Test]
+        public void should_run_after_all_upstream_specifications()
+        {
+            ((int)Subject.Priority).Should().BeGreaterThan((int)SpecificationPriority.Disk);
+        }
+
+        [Test]
+        public void should_reject_everything_locally_in_shadow_mode()
+        {
+            _options.ShadowMode = true;
+            _options.Url = null;
+
+            var decision = Subject.IsSatisfiedBy(_remoteMovie, new ReleaseDecisionInformation());
+
+            decision.Accepted.Should().BeFalse();
+            decision.Reason.Should().Be(DownloadRejectionReason.MediaGuardShadowMode);
+            decision.Message.Should().Contain("[MEDIAGUARD_SHADOW_MODE]");
+            Mocker.GetMock<IMediaGuardHookClient>().Verify(v => v.Send(It.IsAny<string>(), It.IsAny<object>()), Times.Never());
+        }
+
+        [Test]
+        public void should_reject_with_mediaguard_reason()
+        {
+            GivenResult(new MediaGuardHookResult { Decision = MediaGuardDecision.Reject, ReasonCode = "AUDIO_PREFERENCE", Message = "Geen Dual Audio" });
+
+            var decision = Subject.IsSatisfiedBy(_remoteMovie, new ReleaseDecisionInformation());
+
+            decision.Accepted.Should().BeFalse();
+            decision.Reason.Should().Be(DownloadRejectionReason.MediaGuardRejected);
+            decision.Message.Should().Be("MediaGuard: Geen Dual Audio [AUDIO_PREFERENCE]");
+        }
+
+        [Test]
+        public void should_mark_unavailable_rejection()
+        {
+            GivenResult(new MediaGuardHookResult { Decision = MediaGuardDecision.Reject, ReasonCode = MediaGuardHookClient.UnavailableReasonCode, Message = "down", Unavailable = true });
+
+            Subject.IsSatisfiedBy(_remoteMovie, new ReleaseDecisionInformation()).Reason.Should().Be(DownloadRejectionReason.MediaGuardUnavailable);
+        }
+
+        [Test]
+        public void should_accept_and_apply_score_adjustment()
+        {
+            GivenResult(new MediaGuardHookResult { Decision = MediaGuardDecision.Accept, ScoreAdjustment = -30 });
+
+            Subject.IsSatisfiedBy(_remoteMovie, new ReleaseDecisionInformation()).Accepted.Should().BeTrue();
+            _remoteMovie.CustomFormatScore.Should().Be(70);
+        }
+
+        [TestCase(false, "search")]
+        [TestCase(true, "interactive")]
+        public void should_send_contract_payload(bool interactive, string searchType)
+        {
+            GivenResult(new MediaGuardHookResult { Decision = MediaGuardDecision.Accept });
+
+            Subject.IsSatisfiedBy(_remoteMovie, new ReleaseDecisionInformation(false, new MovieSearchCriteria { InteractiveSearch = interactive }));
+
+            var payload = _payload as MediaGuardPreGrabRequest;
+            payload.Should().NotBeNull();
+            payload.InstanceId.Should().Be("radarr-animefilms");
+            payload.App.Should().Be("radarr");
+            payload.SearchType.Should().Be(searchType);
+            payload.Release.Quality.Should().Be("Bluray-1080p");
+            payload.Release.Resolution.Should().Be(1080);
+            payload.Movie.TmdbId.Should().Be(129);
+            payload.Movie.ImdbId.Should().Be("tt0245429");
+            payload.Movie.Year.Should().Be(2001);
+            payload.Series.Should().BeNull();
+            payload.Episodes.Should().BeNull();
+        }
+
+        [Test]
+        public void should_report_rss_search_type_without_criteria()
+        {
+            GivenResult(new MediaGuardHookResult { Decision = MediaGuardDecision.Accept });
+
+            Subject.IsSatisfiedBy(_remoteMovie, new ReleaseDecisionInformation());
+
+            ((MediaGuardPreGrabRequest)_payload).SearchType.Should().Be("rss");
+        }
+    }
+}
