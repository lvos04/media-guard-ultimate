@@ -0,0 +1,162 @@
+using System;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Serialization;
+using NLog;
+using NzbDrone.Common.Extensions;
+using NzbDrone.Common.Http;
+
+namespace NzbDrone.Core.MediaGuard
+{
+    public enum MediaGuardDecision
+    {
+        Accept,
+        Reject,
+        Defer
+    }
+
+    public class MediaGuardHookResult
+    {
+        public MediaGuardDecision Decision { get; set; }
+        public string ReasonCode { get; set; }
+        public string Message { get; set; }
+        public int ScoreAdjustment { get; set; }
+
+        // True when MediaGuard could not be reached (timeout, error, invalid response) and the fail policy was applied
+        public bool Unavailable { get; set; }
+
+        public string FormatRejection()
+        {
+            var reasonCode = ReasonCode.IsNullOrWhiteSpace() ? "UNSPECIFIED" : ReasonCode;
+            var message = Message.IsNullOrWhiteSpace() ? "Release geweigerd" : Message;
+
+            return $"MediaGuard: {message} [{reasonCode}]";
+        }
+    }
+
+    public class MediaGuardHookResponse
+    {
+        public string Decision { get; set; }
+        public string ReasonCode { get; set; }
+        public string Message { get; set; }
+        public int ScoreAdjustment { get; set; }
+    }
+
+    public interface IMediaGuardHookClient
+    {
+        MediaGuardHookOptions Options { get; }
+        MediaGuardHookResult Send(string hook, object payload);
+    }
+
+    public class MediaGuardHookClient : IMediaGuardHookClient
+    {
+        public const string HookKeyHeader = "X-MediaGuard-Hook-Key";
+        public const string UnavailableReasonCode = "MEDIAGUARD_UNAVAILABLE";
+        public const string ShadowModeReasonCode = "MEDIAGUARD_SHADOW_MODE";
+
+        public static readonly JsonSerializerSettings SerializerSettings = new ()
+        {
+            ContractResolver = new DefaultContractResolver { NamingStrategy = new SnakeCaseNamingStrategy() },
+            NullValueHandling = NullValueHandling.Include,
+            Formatting = Formatting.None
+        };
+
+        private readonly IHttpClient _httpClient;
+        private readonly IMediaGuardHookOptionsProvider _optionsProvider;
+        private readonly Logger _logger;
+        private readonly object _circuitLock = new ();
+        private DateTime _circuitOpenUntil = DateTime.MinValue;
+
+        public MediaGuardHookClient(IHttpClient httpClient, IMediaGuardHookOptionsProvider optionsProvider, Logger logger)
+        {
+            _httpClient = httpClient;
+            _optionsProvider = optionsProvider;
+            _logger = logger;
+        }
+
+        public MediaGuardHookOptions Options => _optionsProvider.GetOptions();
+
+        public MediaGuardHookResult Send(string hook, object payload)
+        {
+            var options = Options;
+
+            if (!options.IsComplete)
+            {
+                return Unavailable(options, hook, "MEDIAGUARD_INSTANCE_ID en/of MEDIAGUARD_HOOK_KEY ontbreken", true);
+            }
+
+            lock (_circuitLock)
+            {
+                if (DateTime.UtcNow < _circuitOpenUntil)
+                {
+                    return Unavailable(options, hook, $"eerdere storing, nieuwe poging na {_circuitOpenUntil:u}", false);
+                }
+            }
+
+            try
+            {
+                var request = new HttpRequestBuilder($"{options.Url}/api/v1/hooks/{hook}")
+                    .Accept(HttpAccept.Json)
+                    .Post()
+                    .Build();
+
+                request.Headers.ContentType = "application/json";
+                request.Headers.Add(HookKeyHeader, options.HookKey);
+                request.RequestTimeout = TimeSpan.FromMilliseconds(options.TimeoutMs);
+                request.LogHttpError = false;
+                request.SetContent(JsonConvert.SerializeObject(payload, SerializerSettings));
+
+                var response = _httpClient.Execute(request);
+                var body = JsonConvert.DeserializeObject<MediaGuardHookResponse>(response.Content, SerializerSettings);
+
+                if (body == null || !Enum.TryParse<MediaGuardDecision>(body.Decision, true, out var decision))
+                {
+                    throw new FormatException($"Invalid MediaGuard {hook} response decision '{body?.Decision}'");
+                }
+
+                lock (_circuitLock)
+                {
+                    _circuitOpenUntil = DateTime.MinValue;
+                }
+
+                _logger.Debug("MediaGuard {0} decision: {1} [{2}] {3}", hook, decision, body.ReasonCode, body.Message);
+
+                return new MediaGuardHookResult
+                {
+                    Decision = decision,
+                    ReasonCode = body.ReasonCode,
+                    Message = body.Message,
+                    ScoreAdjustment = body.ScoreAdjustment
+                };
+            }
+            catch (Exception ex)
+            {
+                lock (_circuitLock)
+                {
+                    _circuitOpenUntil = DateTime.UtcNow.AddSeconds(options.CircuitBreakSeconds);
+                }
+
+                _logger.Debug(ex, "MediaGuard {0} hook call failed", hook);
+
+                return Unavailable(options, hook, $"{ex.GetType().Name}: {ex.Message}", true);
+            }
+        }
+
+        private MediaGuardHookResult Unavailable(MediaGuardHookOptions options, string hook, string detail, bool logWarning)
+        {
+            var failClosed = options.FailPolicy == MediaGuardFailPolicy.Closed;
+
+            if (logWarning)
+            {
+                _logger.Warn("MediaGuard {0} hook unavailable ({1}); fail policy '{2}' applied", hook, detail, failClosed ? "closed" : "open");
+            }
+
+            return new MediaGuardHookResult
+            {
+                Decision = failClosed ? MediaGuardDecision.Reject : MediaGuardDecision.Accept,
+                ReasonCode = UnavailableReasonCode,
+                Message = $"MediaGuard niet bereikbaar ({detail}); fail policy {(failClosed ? "closed" : "open")}",
+                Unavailable = true
+            };
+        }
+    }
+}
