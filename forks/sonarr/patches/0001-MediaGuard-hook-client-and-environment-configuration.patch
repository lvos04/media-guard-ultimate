@@ -0,0 +1,81 @@
+using System;
+using NzbDrone.Common.Extensions;
+
+namespace NzbDrone.Core.MediaGuard
+{
+    public enum MediaGuardFailPolicy
+    {
+        Open,
+        Closed
+    }
+
+    public class MediaGuardHookOptions
+    {
+        public const int DefaultTimeoutMs = 3000;
+        public const int DefaultCircuitBreakSeconds = 30;
+
+        public string Url { get; set; }
+        public string InstanceId { get; set; }
+        public string HookKey { get; set; }
+        public int TimeoutMs { get; set; } = DefaultTimeoutMs;
+        public MediaGuardFailPolicy FailPolicy { get; set; } = MediaGuardFailPolicy.Open;
+        public bool ShadowMode { get; set; }
+        public int CircuitBreakSeconds { get; set; } = DefaultCircuitBreakSeconds;
+
+        public bool HooksEnabled => Url.IsNotNullOrWhiteSpace();
+
+        public bool IsComplete => HooksEnabled && InstanceId.IsNotNullOrWhiteSpace() && HookKey.IsNotNullOrWhiteSpace();
+
+        public static MediaGuardHookOptions FromEnvironment(Func<string, string> getVariable)
+        {
+            var options = new MediaGuardHookOptions
+            {
+                Url = getVariable("MEDIAGUARD_URL")?.Trim().TrimEnd('/'),
+                InstanceId = getVariable("MEDIAGUARD_INSTANCE_ID")?.Trim(),
+                HookKey = getVariable("MEDIAGUARD_HOOK_KEY")?.Trim(),
+                ShadowMode = IsTrue(getVariable("MEDIAGUARD_SHADOW_MODE"))
+            };
+
+            if (int.TryParse(getVariable("MEDIAGUARD_HOOK_TIMEOUT_MS"), out var timeoutMs) && timeoutMs > 0)
+            {
+                options.TimeoutMs = timeoutMs;
+            }
+
+            if (int.TryParse(getVariable("MEDIAGUARD_HOOK_CIRCUIT_BREAK_SECONDS"), out var circuitBreakSeconds) && circuitBreakSeconds >= 0)
+            {
+                options.CircuitBreakSeconds = circuitBreakSeconds;
+            }
+
+            if (string.Equals(getVariable("MEDIAGUARD_HOOK_FAIL_POLICY")?.Trim(), "closed", StringComparison.OrdinalIgnoreCase))
+            {
+                options.FailPolicy = MediaGuardFailPolicy.Closed;
+            }
+
+            return options;
+        }
+
+        private static bool IsTrue(string value)
+        {
+            value = value?.Trim();
+
+            return value == "1" ||
+                   string.Equals(value, "true", StringComparison.OrdinalIgnoreCase) ||
+                   string.Equals(value, "yes", StringComparison.OrdinalIgnoreCase);
+        }
+    }
+
+    public interface IMediaGuardHookOptionsProvider
+    {
+        MediaGuardHookOptions GetOptions();
+    }
+
+    public class EnvironmentMediaGuardHookOptionsProvider : IMediaGuardHookOptionsProvider
+    {
+        private readonly Lazy<MediaGuardHookOptions> _options = new (() => MediaGuardHookOptions.FromEnvironment(Environment.GetEnvironmentVariable));
+
+        public MediaGuardHookOptions GetOptions()
+        {
+            return _options.Value;
+        }
+    }
+}
diff --git a/src/NzbDrone.Core/MediaGuard/MediaGuardPayloads.cs b/src/NzbDrone.Core/MediaGuard/MediaGuardPayloads.cs
