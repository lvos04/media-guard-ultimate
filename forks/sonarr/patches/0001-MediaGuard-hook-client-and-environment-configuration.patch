+using System;
+using System.Collections.Generic;
+using System.Net;
+using System.Text;
+using FluentAssertions;
+using Moq;
+using Newtonsoft.Json.Linq;
+using NUnit.Framework;
+using NzbDrone.Common.Http;
+using NzbDrone.Core.MediaGuard;
+using NzbDrone.Core.Test.Framework;
+using NzbDrone.Test.Common;
+
+namespace NzbDrone.Core.Test.MediaGuardTests
+{
+    [TestFixture]
+    public class MediaGuardHookClientFixture : CoreTest<MediaGuardHookClient>
+    {
+        private MediaGuardHookOptions _options;
+        private HttpRequest _request;
+
+        [SetUp]
+        public void Setup()
+        {
+            _options = new MediaGuardHookOptions
+            {
+                Url = "http://mediaguard-core:8100",
+                InstanceId = "sonarr-series",
+                HookKey = "secret",
+                TimeoutMs = 1500
+            };
+
+            Mocker.GetMock<IMediaGuardHookOptionsProvider>()
+                  .Setup(v => v.GetOptions())
+                  .Returns(() => _options);
+        }
+
+        private void GivenResponse(string json, HttpStatusCode statusCode = HttpStatusCode.OK)
+        {
+            Mocker.GetMock<IHttpClient>()
+                  .Setup(v => v.Execute(It.IsAny<HttpRequest>()))
+                  .Callback<HttpRequest>(r => _request = r)
+                  .Returns<HttpRequest>(r => new HttpResponse(r, new HttpHeader(), json, statusCode));
+        }
+
+        private void GivenException(Exception ex)
+        {
+            Mocker.GetMock<IHttpClient>()
+                  .Setup(v => v.Execute(It.IsAny<HttpRequest>()))
+                  .Callback<HttpRequest>(r => _request = r)
+                  .Throws(ex);
+        }
+
+        [Test]
+        public void should_post_snake_case_payload_with_hook_key_and_timeout()
+        {
+            GivenResponse("{\"decision\":\"accept\",\"reason_code\":null,\"message\":\"ok\",\"score_adjustment\":0}");
+
+            var result = Subject.Send("pre-grab", new MediaGuardPreGrabRequest { InstanceId = "sonarr-series", SearchType = "rss", Release = new MediaGuardReleasePayload { AgeHours = 1.5 } });
+
+            result.Decision.Should().Be(MediaGuardDecision.Accept);
+            result.Unavailable.Should().BeFalse();
+
+            _request.Url.FullUri.Should().Be("http://mediaguard-core:8100/api/v1/hooks/pre-grab");
+            _request.Method.Should().Be(System.Net.Http.HttpMethod.Post);
+            _request.Headers.GetSingleValue(MediaGuardHookClient.HookKeyHeader).Should().Be("secret");
+            _request.RequestTimeout.Should().Be(TimeSpan.FromMilliseconds(1500));
+
+            var body = JObject.Parse(Encoding.UTF8.GetString(_request.ContentData));
+            body["instance_id"].ToString().Should().Be("sonarr-series");
+            body["search_type"].ToString().Should().Be("rss");
+            body["release"]["age_hours"].Value<double>().Should().Be(1.5);
+            body.ContainsKey("movie").Should().BeTrue();
+        }
+
+        [TestCase("reject", MediaGuardDecision.Reject)]
+        [TestCase("REJECT", MediaGuardDecision.Reject)]
+        [TestCase("defer", MediaGuardDecision.Defer)]
+        public void should_parse_decision(string decision, MediaGuardDecision expected)
+        {
+            GivenResponse($"{{\"decision\":\"{decision}\",\"reason_code\":\"AUDIO_PREFERENCE\",\"message\":\"Geen Engelse audio\",\"score_adjustment\":15}}");
+
+            var result = Subject.Send("pre-import", new { });
+
+            result.Decision.Should().Be(expected);
+            result.ReasonCode.Should().Be("AUDIO_PREFERENCE");
+            result.ScoreAdjustment.Should().Be(15);
+            result.FormatRejection().Should().Be("MediaGuard: Geen Engelse audio [AUDIO_PREFERENCE]");
+        }
+
+        [Test]
+        public void should_fail_open_on_timeout_by_default()
+        {
+            GivenException(new WebException("timed out", WebExceptionStatus.Timeout));
+
+            var result = Subject.Send("pre-grab", new { });
+
+            result.Decision.Should().Be(MediaGuardDecision.Accept);
+            result.Unavailable.Should().BeTrue();
+            result.ReasonCode.Should().Be(MediaGuardHookClient.UnavailableReasonCode);
+            ExceptionVerification.ExpectedWarns(1);
+        }
+
+        [Test]
+        public void should_fail_closed_when_configured()
+        {
+            _options.FailPolicy = MediaGuardFailPolicy.Closed;
+            GivenException(new WebException("connection refused"));
+
+            var result = Subject.Send("pre-grab", new { });
+
+            result.Decision.Should().Be(MediaGuardDecision.Reject);
+            result.Unavailable.Should().BeTrue();
+            result.FormatRejection().Should().EndWith("[MEDIAGUARD_UNAVAILABLE]");
+            ExceptionVerification.ExpectedWarns(1);
+        }
+
+        [Test]
+        public void should_treat_http_error_and_invalid_decision_as_unavailable()
+        {
+            GivenResponse("{\"decision\":\"maybe\"}");
+
+            Subject.Send("pre-grab", new { }).Unavailable.Should().BeTrue();
+            ExceptionVerification.ExpectedWarns(1);
+        }
+
+        [Test]
+        public void should_not_call_again_while_circuit_is_open()
+        {
+            GivenException(new WebException("connection refused"));
+
+            Subject.Send("pre-grab", new { });
+            Subject.Send("pre-grab", new { }).Unavailable.Should().BeTrue();
+
+            Mocker.GetMock<IHttpClient>().Verify(v => v.Execute(It.IsAny<HttpRequest>()), Times.Once());
+            ExceptionVerification.ExpectedWarns(1);
+        }
+
+        [Test]
+        public void should_apply_fail_policy_without_call_when_key_missing()
+        {
+            _options.HookKey = null;
+            _options.FailPolicy = MediaGuardFailPolicy.Closed;
+
+            Subject.Send("pre-grab", new { }).Decision.Should().Be(MediaGuardDecision.Reject);
+
+            Mocker.GetMock<IHttpClient>().Verify(v => v.Execute(It.IsAny<HttpRequest>()), Times.Never());
+            ExceptionVerification.ExpectedWarns(1);
+        }
+
+        [Test]
+        public void should_read_options_from_environment()
+        {
+            var env = new Dictionary<string, string>
+            {
+                { "MEDIAGUARD_URL", "http://core:8100/" },
+                { "MEDIAGUARD_INSTANCE_ID", "sonarr-anime" },
+                { "MEDIAGUARD_HOOK_KEY", "k" },
+                { "MEDIAGUARD_HOOK_TIMEOUT_MS", "250" },
+                { "MEDIAGUARD_HOOK_FAIL_POLICY", "Closed" },
+                { "MEDIAGUARD_SHADOW_MODE", "1" }
+            };
+
+            var options = MediaGuardHookOptions.FromEnvironment(k => env.GetValueOrDefault(k));
+
+            options.Url.Should().Be("http://core:8100");
+            options.InstanceId.Should().Be("sonarr-anime");
+            options.TimeoutMs.Should().Be(250);
+            options.FailPolicy.Should().Be(MediaGuardFailPolicy.Closed);
+            options.ShadowMode.Should().BeTrue();
+            options.IsComplete.Should().BeTrue();
+
+            var defaults = MediaGuardHookOptions.FromEnvironment(k => null);
+            defaults.HooksEnabled.Should().BeFalse();
+            defaults.TimeoutMs.Should().Be(3000);
+            defaults.FailPolicy.Should().Be(MediaGuardFailPolicy.Open);
+            defaults.ShadowMode.Should().BeFalse();
+        }
+    }
+}
