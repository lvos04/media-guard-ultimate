+using System;
+using System.Collections.Generic;
+using System.Linq;
+using NzbDrone.Common.Extensions;
+using NzbDrone.Core.CustomFormats;
+using NzbDrone.Core.Download;
+using NzbDrone.Core.Indexers;
+using NzbDrone.Core.IndexerSearch.Definitions;
+using NzbDrone.Core.Languages;
+using NzbDrone.Core.Parser.Model;
+using NzbDrone.Core.Tv;
+
+namespace NzbDrone.Core.MediaGuard
+{
+    public class MediaGuardPreGrabRequest
+    {
+        public string InstanceId { get; set; }
+        public string App { get; set; }
+        public string SearchType { get; set; }
+        public MediaGuardReleasePayload Release { get; set; }
+        public MediaGuardSeriesPayload Series { get; set; }
+        public object Movie { get; set; }
+        public List<MediaGuardEpisodePayload> Episodes { get; set; }
+        public MediaGuardParsedPayload Parsed { get; set; }
+    }
+
+    public class MediaGuardPreImportRequest
+    {
+        public string InstanceId { get; set; }
+        public string App { get; set; }
+        public string Path { get; set; }
+        public long Size { get; set; }
+        public string DownloadClient { get; set; }
+        public string DownloadId { get; set; }
+        public string ReleaseTitle { get; set; }
+        public bool IsUpgrade { get; set; }
+        public MediaGuardSeriesPayload Series { get; set; }
+        public object Movie { get; set; }
+        public List<MediaGuardEpisodePayload> Episodes { get; set; }
+        public MediaGuardParsedPayload Parsed { get; set; }
+        public MediaGuardMediaInfoPayload MediaInfo { get; set; }
+    }
+
+    public class MediaGuardReleasePayload
+    {
+        public string Title { get; set; }
+        public string Guid { get; set; }
+        public string Indexer { get; set; }
+        public int IndexerId { get; set; }
+        public string Protocol { get; set; }
+        public long Size { get; set; }
+        public double AgeHours { get; set; }
+        public int? Seeders { get; set; }
+        public string Quality { get; set; }
+        public int Resolution { get; set; }
+        public string Source { get; set; }
+        public List<string> Languages { get; set; }
+        public string ReleaseGroup { get; set; }
+        public int CustomFormatScore { get; set; }
+        public List<string> CustomFormats { get; set; }
+        public List<string> IndexerFlags { get; set; }
+    }
+
+    public class MediaGuardSeriesPayload
+    {
+        public int Id { get; set; }
+        public int TvdbId { get; set; }
+        public string ImdbId { get; set; }
+        public string Title { get; set; }
+        public string SeriesType { get; set; }
+    }
+
+    public class MediaGuardEpisodePayload
+    {
+        public int Id { get; set; }
+        public int SeasonNumber { get; set; }
+        public int EpisodeNumber { get; set; }
+        public int? AbsoluteEpisodeNumber { get; set; }
+    }
+
+    public class MediaGuardParsedPayload
+    {
+        public int SeasonNumber { get; set; }
+        public int[] EpisodeNumbers { get; set; }
+        public int[] AbsoluteEpisodeNumbers { get; set; }
+        public bool FullSeason { get; set; }
+        public bool Special { get; set; }
+    }
+
+    public class MediaGuardMediaInfoPayload
+    {
+        public string VideoCodec { get; set; }
+        public List<string> AudioLanguages { get; set; }
+        public List<string> Subtitles { get; set; }
+        public int RunTimeSeconds { get; set; }
+        public string Resolution { get; set; }
+    }
+
+    public static class MediaGuardPayloadBuilder
+    {
+        public const string App = "sonarr";
+
+        public static string GetSearchType(SearchCriteriaBase searchCriteria)
+        {
+            if (searchCriteria == null)
+            {
+                return "rss";
+            }
+
+            return searchCriteria.InteractiveSearch ? "interactive" : "search";
+        }
+
+        public static MediaGuardPreGrabRequest BuildPreGrab(MediaGuardHookOptions options, RemoteEpisode remoteEpisode, SearchCriteriaBase searchCriteria)
+        {
+            var release = remoteEpisode.Release;
+            var quality = remoteEpisode.ParsedEpisodeInfo?.Quality?.Quality;
+
+            return new MediaGuardPreGrabRequest
+            {
+                InstanceId = options.InstanceId,
+                App = App,
+                SearchType = GetSearchType(searchCriteria),
+                Release = new MediaGuardReleasePayload
+                {
+                    Title = release.Title,
+                    Guid = release.Guid,
+                    Indexer = release.Indexer,
+                    IndexerId = release.IndexerId,
+                    Protocol = GetProtocol(release.DownloadProtocol),
+                    Size = release.Size,
+                    AgeHours = Math.Round(release.AgeHours, 2),
+                    Seeders = TorrentInfo.GetSeeders(release),
+                    Quality = quality?.Name,
+                    Resolution = quality?.Resolution ?? 0,
+                    Source = quality?.Source.ToString().ToLowerInvariant(),
+                    Languages = (remoteEpisode.Languages ?? new List<Language>()).Select(l => l.Name).ToList(),
+                    ReleaseGroup = remoteEpisode.ParsedEpisodeInfo?.ReleaseGroup,
+                    CustomFormatScore = remoteEpisode.CustomFormatScore,
+                    CustomFormats = (remoteEpisode.CustomFormats ?? new List<CustomFormat>()).Select(c => c.Name).ToList(),
+                    IndexerFlags = GetIndexerFlags(release.IndexerFlags)
+                },
+                Series = BuildSeries(remoteEpisode.Series),
+                Movie = null,
+                Episodes = BuildEpisodes(remoteEpisode.Episodes),
+                Parsed = BuildParsed(remoteEpisode.ParsedEpisodeInfo)
+            };
+        }
+
+        public static MediaGuardPreImportRequest BuildPreImport(MediaGuardHookOptions options, LocalEpisode localEpisode, DownloadClientItem downloadClientItem)
+        {
+            var mediaInfo = localEpisode.MediaInfo;
+            var parsed = localEpisode.FileEpisodeInfo ?? localEpisode.FolderEpisodeInfo ?? localEpisode.DownloadClientEpisodeInfo;
+
+            return new MediaGuardPreImportRequest
+            {
+                InstanceId = options.InstanceId,
+                App = App,
+                Path = localEpisode.Path,
+                Size = localEpisode.Size,
+                DownloadClient = downloadClientItem?.DownloadClientInfo?.Name,
+                DownloadId = downloadClientItem?.DownloadId,
+                ReleaseTitle = localEpisode.Release?.Title ?? downloadClientItem?.Title ?? localEpisode.SceneName,
+                IsUpgrade = localEpisode.Episodes?.Any(e => e.EpisodeFileId > 0) ?? false,
+                Series = BuildSeries(localEpisode.Series),
+                Movie = null,
+                Episodes = BuildEpisodes(localEpisode.Episodes),
+                Parsed = BuildParsed(parsed),
+                MediaInfo = mediaInfo == null
+                    ? null
+                    : new MediaGuardMediaInfoPayload
+                    {
+                        VideoCodec = mediaInfo.VideoFormat,
+                        AudioLanguages = mediaInfo.AudioLanguages ?? new List<string>(),
+                        Subtitles = mediaInfo.Subtitles ?? new List<string>(),
+                        RunTimeSeconds = (int)mediaInfo.RunTime.TotalSeconds,
+                        Resolution = mediaInfo.Width > 0 ? $"{mediaInfo.Width}x{mediaInfo.Height}" : null
+                    }
+            };
+        }
+
+        private static string GetProtocol(DownloadProtocol protocol)
+        {
+            return protocol switch
+            {
+                DownloadProtocol.Torrent => "torrent",
+                DownloadProtocol.Usenet => "usenet",
+                _ => "unknown"
+            };
+        }
+
+        private static List<string> GetIndexerFlags(IndexerFlags flags)
+        {
+            return Enum.GetValues<IndexerFlags>()
+                       .Where(f => f != 0 && flags.HasFlag(f))
+                       .Select(f => f.ToString())
+                       .ToList();
+        }
+
+        private static MediaGuardSeriesPayload BuildSeries(Series series)
+        {
+            if (series == null)
+            {
+                return null;
+            }
+
+            return new MediaGuardSeriesPayload
+            {
+                Id = series.Id,
+                TvdbId = series.TvdbId,
+                ImdbId = series.ImdbId.IsNullOrWhiteSpace() ? null : series.ImdbId,
+                Title = series.Title,
+                SeriesType = series.SeriesType.ToString().ToLowerInvariant()
+            };
+        }
+
+        private static List<MediaGuardEpisodePayload> BuildEpisodes(List<Episode> episodes)
+        {
+            return (episodes ?? new List<Episode>()).Select(e => new MediaGuardEpisodePayload
+            {
+                Id = e.Id,
+                SeasonNumber = e.SeasonNumber,
+                EpisodeNumber = e.EpisodeNumber,
+                AbsoluteEpisodeNumber = e.AbsoluteEpisodeNumber
+            }).ToList();
+        }
+
+        private static MediaGuardParsedPayload BuildParsed(ParsedEpisodeInfo parsed)
+        {
+            if (parsed == null)
+            {
+                return null;
+            }
+
+            return new MediaGuardParsedPayload
+            {
+                SeasonNumber = parsed.SeasonNumber,
+                EpisodeNumbers = parsed.EpisodeNumbers ?? Array.Empty<int>(),
+                AbsoluteEpisodeNumbers = parsed.AbsoluteEpisodeNumbers ?? Array.Empty<int>(),
+                FullSeason = parsed.FullSeason,
+                Special = parsed.Special
+            };
+        }
+    }
+}
