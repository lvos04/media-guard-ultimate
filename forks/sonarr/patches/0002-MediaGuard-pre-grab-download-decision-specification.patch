+using NLog;
+using NzbDrone.Core.IndexerSearch.Definitions;
+using NzbDrone.Core.MediaGuard;
+using NzbDrone.Core.Parser.Model;
+
+namespace NzbDrone.Core.DecisionEngine.Specifications
+{
+    // MediaGuard fork patch: asks the external MediaGuard policy service whether a release that passed
+    // all upstream specifications may be grabbed. Runs last (PolicyHook priority) for RSS, automatic and
+    // interactive searches, so only otherwise-acceptable releases cause a (bounded) network call.
+    public class MediaGuardPreGrabSpecification : IDownloadDecisionEngineSpecification
+    {
+        public const string Hook = "pre-grab";
+
+        private readonly IMediaGuardHookClient _hookClient;
+        private readonly Logger _logger;
+
+        public MediaGuardPreGrabSpecification(IMediaGuardHookClient hookClient, Logger logger)
+        {
+            _hookClient = hookClient;
+            _logger = logger;
+        }
+
+        public SpecificationPriority Priority => SpecificationPriority.PolicyHook;
+        public RejectionType Type => RejectionType.Permanent;
+
+        public virtual DownloadSpecDecision IsSatisfiedBy(RemoteEpisode subject, SearchCriteriaBase searchCriteria)
+        {
+            var options = _hookClient.Options;
+
+            if (options.ShadowMode)
+            {
+                _logger.Debug("MediaGuard shadow mode active, rejecting {0}", subject.Release.Title);
+
+                return DownloadSpecDecision.Reject(DownloadRejectionReason.MediaGuardShadowMode,
+                    $"MediaGuard: shadow mode actief, grabs worden lokaal geweigerd [{MediaGuardHookClient.ShadowModeReasonCode}]");
+            }
+
+            if (!options.HooksEnabled)
+            {
+                return DownloadSpecDecision.Accept();
+            }
+
+            var result = _hookClient.Send(Hook, MediaGuardPayloadBuilder.BuildPreGrab(options, subject, searchCriteria));
+
+            if (result.Decision == MediaGuardDecision.Accept)
+            {
+                if (result.ScoreAdjustment != 0)
+                {
+                    _logger.Debug("MediaGuard adjusted custom format score of {0} by {1}", subject.Release.Title, result.ScoreAdjustment);
+                    subject.CustomFormatScore += result.ScoreAdjustment;
+                }
+
+                return DownloadSpecDecision.Accept();
+            }
+
+            return DownloadSpecDecision.Reject(result.Unavailable ? DownloadRejectionReason.MediaGuardUnavailable : DownloadRejectionReason.MediaGuardRejected,
+                result.FormatRejection());
+        }
+    }
+}
