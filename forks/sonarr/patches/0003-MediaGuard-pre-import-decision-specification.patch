+using NLog;
+using NzbDrone.Core.Download;
+using NzbDrone.Core.MediaGuard;
+using NzbDrone.Core.Parser.Model;
+
+namespace NzbDrone.Core.MediaFiles.EpisodeImport.Specifications
+{
+    // MediaGuard fork patch: lets the external MediaGuard policy service verify (accept/reject/defer)
+    // a downloaded file before it is imported into the library. Files already inside the series folder
+    // (disk rescans) are never sent.
+    public class MediaGuardPreImportSpecification : IImportDecisionEngineSpecification
+    {
+        public const string Hook = "pre-import";
+
+        private readonly IMediaGuardHookClient _hookClient;
+        private readonly Logger _logger;
+
+        public MediaGuardPreImportSpecification(IMediaGuardHookClient hookClient, Logger logger)
+        {
+            _hookClient = hookClient;
+            _logger = logger;
+        }
+
+        public ImportSpecDecision IsSatisfiedBy(LocalEpisode localEpisode, DownloadClientItem downloadClientItem)
+        {
+            var options = _hookClient.Options;
+
+            if (!options.HooksEnabled || localEpisode.ExistingFile)
+            {
+                return ImportSpecDecision.Accept();
+            }
+
+            var result = _hookClient.Send(Hook, MediaGuardPayloadBuilder.BuildPreImport(options, localEpisode, downloadClientItem));
+
+            switch (result.Decision)
+            {
+                case MediaGuardDecision.Accept:
+                    return ImportSpecDecision.Accept();
+                case MediaGuardDecision.Defer:
+                    _logger.Debug("MediaGuard deferred import of {0}", localEpisode.Path);
+                    return ImportSpecDecision.Reject(ImportRejectionReason.MediaGuardDeferred, result.FormatRejection());
+                default:
+                    // Unavailable + fail policy 'closed' is a temporary condition: treat as deferred
+                    return ImportSpecDecision.Reject(result.Unavailable ? ImportRejectionReason.MediaGuardUnavailable : ImportRejectionReason.MediaGuardRejected,
+                        result.FormatRejection());
+            }
+        }
+    }
+}
