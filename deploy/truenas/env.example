# MediaGuard Ultimate — OPTIONELE instellingen voor deploy/truenas/compose.yaml
#
# Voor een normale installatie heb je dit bestand NIET nodig: pas in compose.yaml alleen de
# drie paden onderaan aan. Sleutels, tokens, mappen en rechten maakt 'mediaguard-init' zelf
# aan (in <MG_APPDATA>/secrets; neem die map mee in je back-ups/snapshots).
#
# Wil je toch iets wijzigen, zet de variabele dan in TrueNAS bij de app (of in een .env naast
# compose.yaml). Alle waarden hieronder zijn de standaardwaarden, behalve de drie paden (verplicht).

# ── Paden (verplicht: compose.yaml heeft geen standaardpad; <pool> = jouw pool) ────────────
# MG_APPDATA=/mnt/<pool>/apps/mediaguard
# MG_WORK=/mnt/<pool>/mediaguard-work
# MG_DATA_ROOT=/mnt/<pool>/data

# ── Netwerk ────────────────────────────────────────────────────────────────────────────────
# Adres van je TrueNAS zoals Seerr het bereikt. Leeg = MediaGuard gebruikt het adres waarmee
# je de webinterface opent (Inrichten → Seerr).
# MG_HOST=
# MG_WEB_PORT=30080
# MG_PORT_SONARR_SERIES=38989
# MG_PORT_SONARR_ANIME=38990
# MG_PORT_RADARR_FILMS=37878
# MG_PORT_RADARR_ANIMEFILMS=37879
# TZ=Europe/Amsterdam

# ── GPU (encoder) ──────────────────────────────────────────────────────────────────────────
# Groeps-ID's van /dev/dri op de TrueNAS-host. Klopt het niet, dan meldt AV1 Studio →
# GPU-diagnose 'geen toegang' en werkt alleen de CPU; zoek ze dan op met: ls -ln /dev/dri
# MG_RENDER_GID=107
# MG_VIDEO_GID=44

# ── Hookgedrag van de forks ────────────────────────────────────────────────────────────────
# MG_HOOK_TIMEOUT_MS=3000
# MG_HOOK_CIRCUIT_BREAK_SECONDS=30
# MG_SONARR_SERIES_FAIL_POLICY=open      (open = bij storing van MediaGuard toch downloaden)
# MG_SONARR_SERIES_SHADOW_MODE=0         (alleen voor bijzondere migratiescenario's)

# ── Resources ──────────────────────────────────────────────────────────────────────────────
# MG_ENCODE_CPUS=12
# MG_ENCODE_MEM=12g
# MG_CORE_CPUS=2
# MG_CORE_MEM=2g
# MG_RECOVERY_CPUS=2
# MG_RECOVERY_MEM=1g
# MG_FORK_CPUS=2
# MG_FORK_MEM=2g
# MG_ENCODE_MIN_STABLE_SECONDS=60

# ── Images (vast gepind; pas alleen aan bij een update) ────────────────────────────────────
# MG_CORE_IMAGE=ghcr.io/lvos04/mediaguard-core:1.2.2
# MG_WEB_IMAGE=ghcr.io/lvos04/mediaguard-web:1.2.2
# MG_ENCODE_IMAGE=ghcr.io/lvos04/mediaguard-encode:1.2.2
# MG_SONARR_IMAGE=ghcr.io/lvos04/mediaguard-sonarr-fork:4.0.20.3014-mg2
# MG_RADARR_IMAGE=ghcr.io/lvos04/mediaguard-radarr-fork:6.4.4.10685-mg1
